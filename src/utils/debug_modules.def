/*
 * X-macro list of all debug modules.
 * Format: DEBUG_MODULE_ENTRY(name, bit_position)
 *
 * This file is included multiple times with different DEBUG_MODULE_ENTRY
 * definitions to generate enums, name tables, and other module-related
 * data structures.
 */

/* Library Core */
DEBUG_MODULE_ENTRY(LIB,                     0)
DEBUG_MODULE_ENTRY(INIT,                    1)
DEBUG_MODULE_ENTRY(VERSION,                 2)

/* Utilities */
DEBUG_MODULE_ENTRY(UTILS,                   3)

/* Allen-Bradley Protocol */
DEBUG_MODULE_ENTRY(AB_SESSION,              4)
DEBUG_MODULE_ENTRY(AB_PCCC,                 5)
DEBUG_MODULE_ENTRY(AB_CIP,                  6)
DEBUG_MODULE_ENTRY(AB_COMMON,               7)
DEBUG_MODULE_ENTRY(AB_EIP_CIP,              8)
DEBUG_MODULE_ENTRY(AB_EIP_CIP_SPECIAL,      9)
DEBUG_MODULE_ENTRY(AB_EIP_LGX_PCCC,        10)
DEBUG_MODULE_ENTRY(AB_EIP_PLC5_PCCC,       11)
DEBUG_MODULE_ENTRY(AB_EIP_PLC5_DHP,        12)
DEBUG_MODULE_ENTRY(AB_EIP_SLC_PCCC,        13)
DEBUG_MODULE_ENTRY(AB_EIP_SLC_DHP,         14)
DEBUG_MODULE_ENTRY(AB_ERROR,               15)

/* Omron Protocol */
DEBUG_MODULE_ENTRY(OMRON_CONN,             16)
DEBUG_MODULE_ENTRY(OMRON_CIP,              17)
DEBUG_MODULE_ENTRY(OMRON_COMMON,           18)
DEBUG_MODULE_ENTRY(OMRON_STANDARD_TAG,     19)
DEBUG_MODULE_ENTRY(OMRON_RAW_TAG,          20)

/* Modbus Protocol */
DEBUG_MODULE_ENTRY(MODBUS,                 21)

/* System */
DEBUG_MODULE_ENTRY(SYSTEM,                 22)
